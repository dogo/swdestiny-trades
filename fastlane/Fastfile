# Customise this file, documentation can be found here:
# https://docs.fastlane.tools/actions
# can also be listed using the `fastlane actions` command

# This is the minimum version number required.
fastlane_version "2.236.1"

default_platform :ios

# Project is generated by Tuist (see Project.swift / Workspace.swift).
WORKSPACE  = "swdestiny-trades.xcworkspace"
PROJECT    = "swdestiny-trades.xcodeproj"
SCHEME     = "SWDestinyTrades"
APP_ID     = "br.com.anykey.SWDestiny-Trades"

platform :ios do
  before_all do
    # Fetch SPM dependencies and (re)generate the Xcode project/workspace.
    # `sh` runs inside the fastlane/ folder, so step up to the repo root first.
    # `mise exec` pins the tuist version from mise.toml regardless of PATH.
    sh("cd .. && mise exec -- tuist install && mise exec -- tuist generate --no-open")
  end

  desc "Runs all the tests and retrieve code coverage using Slather"
  lane :app_report do
    scan(
      workspace: WORKSPACE,
      scheme: SCHEME,
      clean: true,
      code_coverage: true
    )

    slather(
      html: true,
      show: true,
      use_bundle_exec: true,
      ignore: [
        "SWDestinyTrades/Resources/*",
        "SWDestinyTrades/Classes/Generated/*",
        "Tuist/.build/*",
        "**/Derived/*"
      ],
      output_directory: "CoverageReport",
      scheme: SCHEME,
      proj: PROJECT,
      workspace: WORKSPACE
    )
  end

  desc "Submit a new Beta Build to Apple TestFlight"
  desc "This will also make sure the signing profile is up to date"
  lane :beta do
    match(type: "appstore", app_identifier: APP_ID, readonly: true)
    gym(
      scheme: SCHEME,
      workspace: WORKSPACE,
      export_options: "./fastlane/exportOptions.plist"
    )
    pilot(skip_waiting_for_build_processing: true)
  end

  desc "Deploy a new version to the App Store"
  lane :release do
    match(type: "appstore", app_identifier: APP_ID, readonly: true)
    gym(
      scheme: SCHEME,
      workspace: WORKSPACE,
      export_options: "./fastlane/exportOptions.plist"
    )
    deliver(force: true)
  end

  error do |lane, exception|
    # slack(message: exception.message, success: false)
  end
end
